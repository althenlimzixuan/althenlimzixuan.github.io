---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import EtpArchitecture from '../../components/etp/EtpArchitecture.astro';
import { primaryCtaHref, primaryCtaLabel } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<ProseLayout
  title={data.title}
  description={data.tagline}
  eyebrow={`${data.role} · ${data.period}`}
  lede={data.tagline}
>
  {/* Bespoke to this one case study: the architecture module is built from
      ETP's own copy and diagram, not from anything generic in the schema. A
      second project wanting one would justify a schema flag; one does not. */}
  {entry.id === 'etp' && <EtpArchitecture slot="lead" />}

  <Content />
  <p class="cta">
    <a href={primaryCtaHref()}>{primaryCtaLabel()} →</a>
  </p>
</ProseLayout>

<style>
  .cta {
    margin-block-start: var(--s-16);
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: var(--t-lg);
  }
</style>
