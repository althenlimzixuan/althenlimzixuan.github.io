---
import Scrolly from '../scrolly/Scrolly.astro';
import PipelineDiagram from './PipelineDiagram.astro';
import { processSteps } from '../../data/process';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Scrolly
  id="process-scrolly"
  heading="How I build"
  steps={processSteps}
  class={className}
>
  <PipelineDiagram slot="figure" />
  <p slot="footer" class="more">
    <a href="/how-i-build/">See the full process →</a>
  </p>
</Scrolly>

<style>
  .more {
    font-family: var(--f-mono);
    font-weight: 600;
  }
</style>
