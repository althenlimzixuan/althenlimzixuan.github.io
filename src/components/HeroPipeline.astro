---
/**
 * The thesis, drawn: one spec forks into three surfaces and converges on one
 * gate. Unlabelled on purpose — the hero shows the shape, and the labels
 * arrive later in the "How I build" module. Naming the nodes twice would make
 * the hero a summary of the page rather than an opening.
 *
 * This is the only load-time animation on the site. It is additive rather than
 * withholding: the hero text is fully readable from the first paint and the
 * line draws beside it, so nothing is hidden waiting for motion. That is the
 * distinction that makes it acceptable here while a fade-in reveal of the hero
 * would not be.
 *
 * Every stroke carries pathLength="1", which normalises each path's length to
 * 1 regardless of its real geometry — so one dasharray/dashoffset pair draws
 * every line correctly and the timing can be staggered by index without
 * measuring anything.
 */
---

<svg
  class="hero-pipeline"
  viewBox="0 0 120 190"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <g class="lines" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="square">
    <path pathLength="1" style="--i: 1" d="M60 16 V50" />
    <path pathLength="1" style="--i: 2" d="M18 50 H102" />
    <path pathLength="1" style="--i: 3" d="M18 50 V86" />
    <path pathLength="1" style="--i: 3" d="M60 50 V86" />
    <path pathLength="1" style="--i: 3" d="M102 50 V86" />
    <path pathLength="1" style="--i: 5" d="M18 98 V134" />
    <path pathLength="1" style="--i: 5" d="M60 98 V134" />
    <path pathLength="1" style="--i: 5" d="M102 98 V134" />
    <path pathLength="1" style="--i: 6" d="M18 134 H102" />
    <path pathLength="1" style="--i: 7" d="M60 134 V168" />
  </g>

  <g class="dots" fill="currentColor" stroke="none">
    <circle cx="60" cy="10" r="3" style="--i: 0" />
    <circle cx="18" cy="92" r="3" style="--i: 4" />
    <circle cx="60" cy="92" r="3" style="--i: 4" />
    <circle cx="102" cy="92" r="3" style="--i: 4" />
    <circle cx="60" cy="174" r="3" style="--i: 8" />
  </g>
</svg>

<style>
  .hero-pipeline {
    inline-size: 100%;
    block-size: auto;
    color: var(--c-rule);
  }

  /* The fork is the claim, so it is the only part drawn in full-strength ink.
     Everything else stays a hairline. */
  .dots circle:nth-child(2),
  .dots circle:nth-child(3),
  .dots circle:nth-child(4) {
    fill: var(--c-accent);
  }

  .lines path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 420ms ease-out forwards;
    animation-delay: calc(var(--i) * 110ms);
  }

  .dots circle {
    opacity: 0;
    animation: ink 260ms ease-out forwards;
    animation-delay: calc(var(--i) * 110ms);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes ink {
    to {
      opacity: 1;
    }
  }

  /* Renders complete and instantly. Note this cannot rely on global.css's
     blanket `animation-duration: 0.01ms` — that would still run the sequence,
     just imperceptibly fast, leaving a flash. Setting `animation: none` with
     the finished values is what actually makes it static. */
  @media (prefers-reduced-motion: reduce) {
    .lines path {
      animation: none;
      stroke-dashoffset: 0;
    }

    .dots circle {
      animation: none;
      opacity: 1;
    }
  }
</style>
