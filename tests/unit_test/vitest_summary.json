{
  "description": "summarises a real vitest --reporter=json run (trimmed: one file passing with a skip, one with a failed test, one that failed to load) and runs the report commands with the build failing",
  "input": {
    "vitest": {
      "numTotalTests": 5,
      "numPassedTests": 3,
      "numFailedTests": 1,
      "success": false,
      "testResults": [
        {
          "name": "tests/a.test.js",
          "status": "passed",
          "message": "",
          "assertionResults": [
            {
              "title": "adds",
              "fullName": "adds",
              "status": "passed",
              "failureMessages": []
            },
            {
              "title": "joins",
              "fullName": "joins",
              "status": "passed",
              "failureMessages": []
            },
            {
              "title": "later",
              "fullName": "later",
              "status": "skipped",
              "failureMessages": []
            }
          ]
        },
        {
          "name": "tests/b.test.js",
          "status": "failed",
          "message": "",
          "assertionResults": [
            {
              "title": "passes",
              "fullName": "passes",
              "status": "passed",
              "failureMessages": []
            },
            {
              "title": "fails",
              "fullName": "fails",
              "status": "failed",
              "failureMessages": [
                "AssertionError: expected 1 to be 2 // Object.is equality"
              ]
            }
          ]
