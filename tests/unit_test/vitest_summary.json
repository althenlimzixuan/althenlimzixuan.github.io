        {
          "name": "tests/c.test.js",
          "status": "failed",
          "message": "Cannot find module './does-not-exist.js'",
          "assertionResults": []
        }
      ]
    },
    "runs": [
      {
        "status": 0
      },
      {
        "status": 0
      },
      {
        "status": 1
      },
      {
        "status": 0
      }
    ],
    "injectionOutDir": "_test_reports/site/x\"; echo injected; \""
  },
  "expected": {
    "passed": 3,
    "failed": 2,
    "skipped": 1,
    "files": [
      {
        "name": "tests/a.test.js",
        "passed": 2,
        "failed": 0,
        "skipped": 1
      },
      {
        "name": "tests/b.test.js",
        "passed": 1,
        "failed": 1,
        "skipped": 0
      },
      {
        "name": "tests/c.test.js",
        "passed": 0,
        "failed": 1,
        "skipped": 0
      }
